# Deployment secrets — set these on the HOST (Render/Fly dashboard), NEVER commit real values.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM private key of the GitHub App. Single-line form with \n escapes is accepted.
GITHUB_APP_PRIVATE_KEY=
# Bearer token ChatGPT must present (when using a header-capable client) — generate a long random value.
MCP_AUTH_TOKEN=
ALLOWED_REPOS=gustuplode/render-studio
PORT=8080
